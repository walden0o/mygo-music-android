{
  "id": "qqmusic",
  "name": "QQ Music",
  "version": "0.3.0",
  "minAppVersion": "0.1.8",
  "main": "index.js",
  "playback": "stream",
  "permissions": {
    "network": [
      "u.y.qq.com",
      "c.y.qq.com",
      "c6.y.qq.com",
      "y.qq.com",
      "xui.ptlogin2.qq.com",
      "ssl.ptlogin2.graph.qq.com",
      "graph.qq.com",
      "api.tencentmusic.com",
      "open.weixin.qq.com",
      "lp.open.weixin.qq.com"
    ]
  },
  "settings": [
    {
      "key": "loginMethod",
      "label": "Login method",
      "help": "Enter QQ or WeChat. Leave empty for QQ.",
      "helpForText": true,
      "options": [
        {
          "value": "qq",
          "label": "QQ"
        },
        {
          "value": "wechat",
          "label": "WeChat"
        }
      ]
    }
  ],
  "navigation": [
    {
      "builtin": "home"
    },
    {
      "title": "Featured Playlists",
      "page": "playlists",
      "icon": "playlist"
    },
    {
      "title": "Charts",
      "page": "charts",
      "icon": "chart"
    },
    {
      "builtin": "liked"
    },
    {
      "builtin": "savedAlbums"
    },
    {
      "builtin": "stations"
    }
  ]
}
